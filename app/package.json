{
  "name": "plank-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@types/jest": "30.0.0",
    "expo": "~58.0.15",
    "expo-constants": "~58.0.12",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:test": "EXPO_PUBLIC_PLANK_TEST_MODE=1 expo start --dev-client --clear",
    "ios": "EXPO_USE_PRECOMPILED_MODULES=0 expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node --no-warnings scripts/check-contrast.mjs",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:contrast && npm test",
    "test:ui": "maestro test .maestro",
    "test:e2e:ios": "bash scripts/e2e-ios.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
