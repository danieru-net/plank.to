---
import { storeLinks } from '../config';

interface Props {
  class?: string;
  /** Unique per page, for the "coming soon" note the badges point to. */
  noteId: string;
}

const { class: className, noteId } = Astro.props;
const note = storeLinks.live ? undefined : noteId;
---

<div class:list={['store-badges', className]}>
  <a class="store-badge" href={storeLinks.appStore} aria-describedby={note}>
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path
        fill="currentColor"
        d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-2.99-.79-1.54.02-2.96.9-3.75 2.27-1.6 2.78-.41 6.89 1.15 9.14.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74s1.78.74 2.99.72c1.24-.02 2.02-1.12 2.77-2.23.88-1.28 1.24-2.52 1.26-2.58-.03-.01-2.41-.93-2.43-3.66ZM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.05-.52 2.69-1.28Z"
      ></path>
    </svg>
    <span>
      <small>Download on the</small> App Store
    </span>
  </a>
  <a class="store-badge" href={storeLinks.googlePlay} aria-describedby={note}>
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path
        fill="#00d7fe"
        d="M3.6 2.3 13.3 12l-9.7 9.7c-.4-.2-.6-.6-.6-1.1V3.4c0-.5.2-.9.6-1.1Z"
      ></path>
      <path fill="#ffce00" d="m16.6 15.3-3.3-3.3 3.3-3.3 3.8 2.2c1 .6 1 1.6 0 2.2l-3.8 2.2Z"></path>
      <path fill="#ff3a44" d="M16.6 15.3 13.3 12l-9.7 9.7c.4.2.9.2 1.4-.1l11.6-6.3Z"></path>
      <path fill="#00f076" d="M16.6 8.7 5 2.4c-.5-.3-1-.3-1.4-.1l9.7 9.7 3.3-3.3Z"></path>
    </svg>
    <span>
      <small>Get it on</small> Google Play
    </span>
  </a>
  {!storeLinks.live && (
    <p class="store-note" id={note}>
      Coming soon to the App Store and Google Play.
    </p>
  )}
</div>
