---
interface Props {
  currentPath: string;
  cta?: { href: string; label: string } | undefined;
}

const { currentPath, cta } = Astro.props;

const links = [
  { href: '/', label: 'Overview' },
  { href: '/help/', label: 'Help' },
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/contact/', label: 'Contact' },
];

const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      plank.to
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={normalize(currentPath) === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {cta && (
      <a class="header-cta" href={cta.href}>
        {cta.label}
      </a>
    )}
  </div>
</header>
